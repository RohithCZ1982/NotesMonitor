# ─── Backend (.env in /backend) ───────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/notes-monitor

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Default Admin credentials (created on first run if no admin exists)
ADMIN_EMAIL=admin@notesmonitor.com
ADMIN_PASSWORD=Admin@123
ADMIN_MOBILE=9000000000

# CORS — URL of the frontend dev server
CLIENT_URL=http://localhost:5173


# ─── Frontend (.env in /frontend) ─────────────────────────────────────────────

# API base URL (no trailing slash)
VITE_API_URL=http://localhost:5000
