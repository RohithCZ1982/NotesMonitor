{
  "name": "notes-monitor-backend",
  "version": "1.0.0",
  "description": "Notes Distribution System - Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --dns-result-order=ipv4first node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node --dns-result-order=ipv4first dist/server.js",
    "reset-admin": "node --dns-result-order=ipv4first node_modules/ts-node/dist/bin.js --transpile-only src/scripts/reset-admin.ts"
  },
  "dependencies": {
    "archiver": "^6.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
